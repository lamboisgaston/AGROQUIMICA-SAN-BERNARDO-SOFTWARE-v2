# Copiar este archivo a .env y completar con valores reales (nunca commitear .env).

# Base de datos
DATABASE_URL="file:./dev.db"

# IA / chatbot (opcional)
OPENAI_API_KEY=""

# Autenticación - hashes bcrypt de las contraseñas de cada usuario.
# Generar un hash nuevo con: node scripts/hash-password.js "miContraseñaNueva"
ADMIN_PASSWORD_HASH=""
GERENTE_PASSWORD_HASH=""
OPERADOR_PASSWORD_HASH=""

# Password (hash bcrypt) requerida para eliminar registros protegidos (cierres de caja, etc.)
PASSWORD_ELIMINACION_HASH=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Producto {
  id                Int        @id @default(autoincrement())
  nombre            String
  categoria         String
  stock             Int        @default(0)
  proveedorId       Int?
  proveedor         Proveedor? @relation(fields: [proveedorId], references: [id])
  monedaCosto       String     @default("USD")
  costoBase         Float      @default(0)
  porcentajeUva     Float      @default(0)
  porcentajeFlete   Float      @default(0)
  porcentajeGanancia Float     @default(0)
  precioFinalPesos  Float      @default(0)
  precioUsd         Float?
  items             VentaItem[]
  movimientosStock  MovimientoStock[]
}

model Proveedor {
  id             Int        @id @default(autoincrement())
  nombre         String
  telefono       String?
  cuit           String?
  observaciones  String?
  productos      Producto[]
}

model MovimientoStock {
  id         Int      @id @default(autoincrement())
  productoId Int
  tipo       TipoMovimientoStock
  cantidad   Int
  motivo     String
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
}

model ConfiguracionGlobal {
  id              Int   @id @default(1)
  tipoCambioActual Float @default(1)
}

model Persona {
  id              Int              @id @default(autoincrement())
  nombre          String
  telefono        String?
  cuitDni         String?
  tipo            String
  ventas          Venta[]
  cuentaCorriente CuentaCorriente?
}

model Venta {
  id        Int         @id @default(autoincrement())
  personaId Int?
  persona   Persona?    @relation(fields: [personaId], references: [id])
  estado    EstadoVenta @default(BORRADOR)
  total     Float       @default(0)
  descuentoTipo String?
  descuentoValor Float   @default(0)
  subtotal  Float       @default(0)
  items     VentaItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  medioPago MedioPago?
  movimientosCuentaCorriente MovimientoCuentaCorriente[]
}

model CierreCajaDiario {
  id                      Int      @id @default(autoincrement())
  fecha                   DateTime @unique
  fechaCaja               String   @unique
  totalEfectivo           Float
  totalTransferencia      Float
  totalTarjeta            Float
  totalCuentaCorriente    Float
  totalGeneral            Float
  createdAt               DateTime @default(now())
}

model VentaItem {
  id           Int      @id @default(autoincrement())
  ventaId      Int
  productoId   Int
  cantidad     Int
  precioUnitario Float
  subtotal     Float
  venta        Venta    @relation(fields: [ventaId], references: [id])
  producto     Producto @relation(fields: [productoId], references: [id])

  @@unique([ventaId, productoId])
}

enum EstadoVenta {
  BORRADOR
  PENDIENTE_CAJA
  COBRADA
}

model CuentaCorriente {
  id         Int      @id @default(autoincrement())
  personaId  Int      @unique
  persona    Persona  @relation(fields: [personaId], references: [id])
  saldo      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  movimientos MovimientoCuentaCorriente[]
}

model MovimientoCuentaCorriente {
  id                Int      @id @default(autoincrement())
  cuentaCorrienteId Int
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])
  ventaId           Int?
  venta             Venta?   @relation(fields: [ventaId], references: [id])
  tipo              TipoMovimientoCuentaCorriente
  monto             Float
  descripcion       String?
  createdAt         DateTime @default(now())
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CUENTA_CORRIENTE
}

enum TipoMovimientoCuentaCorriente {
  DEBITO
  CREDITO
}

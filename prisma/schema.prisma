generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Producto {
  id                Int        @id @default(autoincrement())
  nombre            String
  categoria         String
  marca             String     @default("")
  unidad            String     @default("")
  stock             Int        @default(0)
  stockMinimo       Int        @default(0)
  ultimaActualizacionStock DateTime?
  monedaCosto       String     @default("USD")
  costoBase         Float      @default(0)
  precioVenta       Float      @default(0)
  porcentajeUva     Float      @default(0)
  porcentajeFlete   Float      @default(0)
  porcentajeGanancia Float     @default(0)
  precioFinalPesos  Float      @default(0)
  precioUsd         Float?
  items             VentaItem[]
  movimientosStock  MovimientoStock[]
  proveedores       ProductoProveedor[]
  detalleRemitos    DetalleRemitoProveedor[]
  presupuestoItems  PresupuestoItem[]
  pedidoItems       PedidoItem[]
  categorias        Categoria[]
  activo            Boolean    @default(true)
  eliminado         Boolean    @default(false)
  eliminadoAt       DateTime?
  eliminadoPor      String?
  motivoEliminacion String?
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  productos   Producto[]
}

model Proveedor {
  id                 Int        @id @default(autoincrement())
  razonSocial        String
  cuit               String?
  telefono           String?
  mail               String?
  direccion          String?
  contactoComercial  String?
  observaciones      String?
  productos      ProductoProveedor[]
  remitos        RemitoProveedor[]
  pedidos        Pedido[]
  activo            Boolean    @default(true)
  eliminado         Boolean    @default(false)
  eliminadoAt       DateTime?
  eliminadoPor      String?
  motivoEliminacion String?
}

model Pedido {
  id           Int          @id @default(autoincrement())
  proveedorId  Int
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])
  fecha        DateTime     @default(now())
  tipo         TipoPedido
  observaciones String?
  estado       EstadoPedido @default(BORRADOR)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        PedidoItem[]
}

model PedidoItem {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  productoId Int
  cantidad   Int
  unidad     String
  pedido     Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto   Producto  @relation(fields: [productoId], references: [id])
}

enum TipoPedido {
  SOLICITUD_PRESUPUESTO
  ORDEN_PEDIDO_ENVIO
}

enum EstadoPedido {
  BORRADOR
  ENVIADO
  CONFIRMADO
  CANCELADO
}

model ProductoProveedor {
  productoId  Int
  proveedorId Int
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@id([productoId, proveedorId])
}

model RemitoProveedor {
  id           Int      @id @default(autoincrement())
  proveedorId  Int
  numeroRemito String
  fecha        DateTime
  observaciones String?
  createdAt    DateTime @default(now())
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id])
  detalles     DetalleRemitoProveedor[]
}

model DetalleRemitoProveedor {
  id                Int      @id @default(autoincrement())
  remitoId          Int
  productoId        Int
  cantidad          Int
  costoCompra       Float
  monedaCosto       String
  ivaPorcentaje     Float
  fletePorcentaje   Float
  gananciaPorcentaje Float
  remito            RemitoProveedor @relation(fields: [remitoId], references: [id], onDelete: Cascade)
  producto          Producto @relation(fields: [productoId], references: [id])
}

model MovimientoStock {
  id         Int      @id @default(autoincrement())
  productoId Int
  tipo       TipoMovimientoStock
  cantidad   Int
  motivo     String
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
}

model ConfiguracionGlobal {
  id              Int   @id @default(1)
  tipoCambioActual Float @default(1)
}

model Persona {
  id              Int              @id @default(autoincrement())
  nombre          String
  telefono        String?
  cuitDni         String?
  tipo            String
  tipoCliente     TipoCliente @default(PERSONAL)
  mail            String?
  direccion       String?
  contactoComercial String?
  observaciones   String?
  telefonoEmergencia String?
  ventas          Venta[]
  presupuestos    Presupuesto[]
  cuentaCorriente CuentaCorriente?
  recibosCuentaCorriente ReciboPagoCuentaCorriente[]
  activo            Boolean    @default(true)
  eliminado         Boolean    @default(false)
  eliminadoAt       DateTime?
  eliminadoPor      String?
  motivoEliminacion String?
}

model Presupuesto {
  id                Int                 @id @default(autoincrement())
  personaId          Int?
  persona            Persona?            @relation(fields: [personaId], references: [id])
  nombreLibre        String?
  tipoDestinatario   TipoDestinatarioPresupuesto @default(EXISTENTE)
  subtotal           Float               @default(0)
  descuentoTipo      String?
  descuentoValor     Float               @default(0)
  ajusteRedondeo     Float               @default(0)
  total              Float               @default(0)
  observaciones      String?
  validez            String?
  aliasTransferencia String?
  datosBancarios     String?
  estado             EstadoPresupuesto   @default(BORRADOR)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              PresupuestoItem[]
}

enum TipoDestinatarioPresupuesto {
  EXISTENTE
  LIBRE
  A_QUIEN_CORRESPONDA
}

model PresupuestoItem {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  productoId     Int
  cantidad       Int
  precioUnitario Float
  subtotal       Float
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  producto       Producto    @relation(fields: [productoId], references: [id])
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  VENCIDO
}

model Venta {
  id        Int         @id @default(autoincrement())
  personaId Int?
  persona   Persona?    @relation(fields: [personaId], references: [id])
  estado    EstadoVenta @default(BORRADOR)
  total     Float       @default(0)
  descuentoTipo String?
  descuentoValor Float   @default(0)
  ajusteRedondeo Float  @default(0)
  condicionPagoPrevista CondicionPagoPrevista?
  subtotal  Float       @default(0)
  items     VentaItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  medioPago MedioPago?
  movimientosCuentaCorriente MovimientoCuentaCorriente[]
}

model CierreCajaDiario {
  id                      Int      @id @default(autoincrement())
  fecha                   DateTime
  fechaCaja               String
  turno                   TurnoCaja @default(DIARIO)
  cerradoPorRol           String
  totalEfectivo           Float
  totalTransferencia      Float
  totalTarjeta            Float
  totalCuentaCorriente    Float
  totalGeneral            Float
  createdAt               DateTime @default(now())

  @@unique([fechaCaja, turno])
}

enum TurnoCaja {
  MANANA
  TARDE
  NOCHE
  DIARIO
}

model VentaItem {
  id           Int      @id @default(autoincrement())
  ventaId      Int
  productoId   Int
  cantidad     Int
  precioUnitario Float
  subtotal     Float
  venta        Venta    @relation(fields: [ventaId], references: [id])
  producto     Producto @relation(fields: [productoId], references: [id])

  @@unique([ventaId, productoId])
}

enum EstadoVenta {
  BORRADOR
  PENDIENTE_CAJA
  COBRADA
}

model CuentaCorriente {
  id         Int      @id @default(autoincrement())
  personaId  Int      @unique
  persona    Persona  @relation(fields: [personaId], references: [id])
  saldo      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  movimientos MovimientoCuentaCorriente[]
}

model MovimientoCuentaCorriente {
  id                Int      @id @default(autoincrement())
  cuentaCorrienteId Int
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])
  ventaId           Int?
  venta             Venta?   @relation(fields: [ventaId], references: [id])
  tipo              TipoMovimientoCuentaCorriente
  monto             Float
  descripcion       String?
  createdAt         DateTime @default(now())
  recibo            ReciboPagoCuentaCorriente?
}

model ReciboPagoCuentaCorriente {
  id                  Int      @id @default(autoincrement())
  movimientoId        Int      @unique
  movimiento          MovimientoCuentaCorriente @relation(fields: [movimientoId], references: [id])
  personaId           Int
  persona             Persona  @relation(fields: [personaId], references: [id])
  montoPagado         Float
  medioPago           MedioPago
  fechaPago           DateTime
  observacion         String?
  saldoAnterior       Float
  saldoPosterior      Float
  createdAt           DateTime @default(now())
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CUENTA_CORRIENTE
}

enum CondicionPagoPrevista {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CUENTA_CORRIENTE
  OTRO
}

enum TipoMovimientoCuentaCorriente {
  DEBITO
  CREDITO
}


enum TipoCliente {
  PERSONAL
  EMPRESA
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String
  categoria   String
  precio      Float
  stock       Int     @default(0)
}

model Persona {
  id       Int    @id @default(autoincrement())
  nombre   String
  telefono String
  tipo     String
}
